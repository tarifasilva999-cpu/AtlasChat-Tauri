{
  "name": "atlaschat-tauri",
  "version": "2.6.1",
  "private": true,
  "description": "AtlasChat Tauri 2 desktop",
  "scripts": {
    "desktop": "tauri dev --no-default-features",
    "prepare:desktop": "node scripts/prepare.cjs",
    "build:desktop": "tauri build",
    "build:exe": "tauri build --no-bundle",
    "test": "node --test atlas-updates.test.cjs atlas-poem3.test.cjs desktop/*.test.cjs migration/*.test.cjs tauri/*.test.cjs scripts/*.test.cjs",
    "check:core": "node --test desktop/core.test.cjs desktop/projects.test.cjs desktop/runner.test.cjs desktop/workflow.test.cjs",
    "package:cli": "node scripts/package-cli.cjs",
    "migrate:data": "node migration/export.cjs",
    "chat": "node desktop/cli.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "fflate": "0.8.2",
    "flux-klein.js": "0.6.0",
    "onnxruntime-web": "1.30.0",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "esbuild": "0.25.12"
  }
}
