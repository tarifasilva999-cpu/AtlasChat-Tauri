{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AtlasChat",
  "version": "2.6.0",
  "identifier": "ai.atlas.chat.tauri",
  "build": {
    "beforeDevCommand": "node scripts/prepare.cjs",
    "beforeBuildCommand": "node scripts/prepare.cjs",
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' data: ipc: http://ipc.localhost http://127.0.0.1:* https:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'self' blob:; base-uri 'self'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "AtlasAI",
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "resources/backend/": "backend/",
      "resources/node/": "node/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzNzc5REQ0MzdENDQ4NkEKUldScVNOUTMxSjEzODEwWXNBeUNwWWlJclhIdmFaRXBTWENHbG0wMmhnT2xDbGJPWTJVdjFYU3cK",
      "endpoints": [
        "https://github.com/tarifasilva999-cpu/AtlasChat-Tauri/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
